{
  "name": "worker-bundle-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "generate-sample": "tsx src/cli/main.ts generate --count 100",
    "build-index": "node --import tsx scripts/build-columnar.ts",
    "search-local": "node --import tsx scripts/search-columnar.ts",
    "dev": "node --import tsx scripts/dev-columnar.ts",
    "deploy": "node --import tsx scripts/deploy-columnar.ts",
    "check": "tsc --noEmit",
    "test": "yarn builder:compile && vitest run",
    "bench": "tsx bench/run.ts",
    "bench:demo": "tsx bench/demo-run.ts",
    "bundle": "node --import tsx scripts/bundle-columnar.ts",
    "publish-search-snapshot": "tsx scripts/publish-search-snapshot.ts",
    "bench:global-phrases": "tsx bench/global-phrases.ts",
    "bench:global-retrieval": "tsx bench/global-retrieval-matrix.ts",
    "bench:global-native-retrieval": "tsx bench/global-native-retrieval.ts",
    "builder:compile": "cargo build --release --locked",
    "builder:index": "yarn builder:compile && target/release/work-search-builder build",
    "builder:check": "cargo fmt -- --check && cargo clippy --locked -- -D warnings",
    "builder:test": "yarn builder:compile && cargo test --locked && vitest run tests/rust-builder.test.ts && node --import tsx bench/rust-builder/unicode.ts",
    "bench:builder": "node --import tsx bench/rust-builder/benchmark.ts",
    "columnar:build": "node --import tsx scripts/build-columnar.ts",
    "columnar:pairs": "node --import tsx scripts/build-columnar-pairs.ts",
    "columnar:heads": "node --import tsx scripts/build-columnar-heads.ts",
    "columnar:corpus": "node --import tsx scripts/columnar-corpus.ts",
    "columnar:deploy": "node --import tsx scripts/deploy-columnar.ts",
    "bench:columnar": "node --import tsx bench/columnar/with-tail.ts",
    "bench:legacy:global:build": "tsx src/global/cli.ts build",
    "bench:legacy:global:dev": "tsx src/global/cli.ts dev",
    "bench:legacy:global:search": "tsx src/global/cli.ts search",
    "bench:legacy:global:deploy": "tsx scripts/publish-global.ts",
    "bench:legacy:global:deploy-demo": "tsx scripts/deploy-global.ts",
    "bench:legacy:global:build-pairs": "tsx scripts/build-pair-index.ts",
    "bench:legacy:global:build-pair-costs": "tsx scripts/build-pair-costs.ts",
    "bench:legacy:global:refine-bounds": "tsx scripts/refine-global-bounds.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^24.0.0",
    "csv-parse": "^7.0.3",
    "htmlparser2": "^12.0.0",
    "miniflare": "4.20260730.0",
    "prettier": "^3.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.1.0",
    "vitest": "^5.1.0",
    "workerd": "1.20261110.1",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "sharp": "^0.35.5"
  }
}
