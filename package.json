{
  "name": "worker-bundle-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "generate-sample": "tsx src/cli/main.ts generate --count 100",
    "build-index": "tsx src/cli/main.ts build",
    "search-local": "tsx src/cli/main.ts search",
    "dev": "tsx src/cli/main.ts dev",
    "deploy": "tsx src/cli/main.ts deploy",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "bench": "tsx bench/run.ts && tsx bench/details.ts && tsx bench/compare.ts",
    "bundle": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^24.0.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "sharp": "^0.35.5"
  }
}
