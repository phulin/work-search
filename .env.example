# Export in your shell before npm run deploy (never commit actual credentials).
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=token-for-workers-deployment
R2_ACCESS_KEY_ID=r2-s3-access-key
R2_SECRET_ACCESS_KEY=r2-s3-secret
# R2 token: object read/write access to worker-search-index.

# Global retrieval: Wrangler login is sufficient; S3 credentials are not used.
# Set CLOUDFLARE_ACCOUNT_ID explicitly when selecting among multiple accounts.
GLOBAL_BUCKET=work-search-global
GLOBAL_WORKER=work-search-global
GLOBAL_BUDGET=8
GLOBAL_HEADS=1
GLOBAL_PAGE_KIB=256
